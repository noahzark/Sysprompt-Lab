{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sysprompt.lab/schemas/metric.json",
  "title": "Metric",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "exact",
        "llm_judge",
        "custom"
      ]
    },
    "returns_feedback": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "kind",
    "returns_feedback"
  ],
  "additionalProperties": false
}
