{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sysprompt.lab/schemas/candidate.json",
  "title": "Candidate",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer"
    },
    "pass_streak": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_candidate_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "round",
    "pass_streak",
    "status",
    "version_id"
  ],
  "additionalProperties": false
}
