{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sysprompt.lab/schemas/prompt-card.json",
  "title": "PromptCard",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "rung": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "bound",
        "optimizing",
        "verifying",
        "promoted",
        "rejected",
        "exported"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "system_prompt": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "is_baseline": {
            "type": "boolean"
          },
          "promoted": {
            "type": "boolean"
          },
          "parent": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "system_prompt",
          "is_baseline",
          "promoted"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "provider",
          "name"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "source",
    "rung",
    "status"
  ],
  "additionalProperties": false
}
