# OpenAI 兼容的 API 根地址 / OpenAI-compatible API base URL (no trailing slash required)
LLM_API_BASE=https://api.openai.com/v1

# 调用所用的模型 / API id（如 gpt-4o-mini、deepseek-chat）
# Model / API id used for calls (e.g. gpt-4o-mini, deepseek-chat)
LLM_API_MODEL=gpt-4o-mini

# 密钥 — 复制为 .env 后填写，切勿提交 .env
# Secret — copy to .env and fill; never commit .env
LLM_API_TOKEN=
