# OpenAI 兼容的 API 根地址 / OpenAI-compatible API base URL
# No trailing slash required. If the value has no /v1 suffix, the client appends /v1
# before POST {base}/chat/completions.
LLM_API_BASE=https://api.openai.com/v1

# 调用所用的模型 / API id（如 gpt-4o-mini、deepseek-chat）
# Model / API id used for calls (e.g. gpt-4o-mini, deepseek-chat)
LLM_API_MODEL=gpt-4o-mini

# 密钥 — 复制为 .env 后填写，切勿提交 .env
# Secret — copy to .env and fill; never commit .env
LLM_API_TOKEN=

# Optional R1 loop knobs (CLI flags override these)
# SYSPROMPT_R1_ROUNDS=3
# SYSPROMPT_R1_CANDIDATES=3
# SYSPROMPT_R1_PASS_STREAK=1
# SYSPROMPT_R1_BUDGET=
