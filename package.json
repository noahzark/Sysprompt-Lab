{
  "name": "sysprompt-lab",
  "version": "0.1.0",
  "description": "Cross-model system-prompt workbench: ingest → optimize → execute → verify → promote.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sysprompt": "./packages/cli/src/cli.ts",
    "spl": "./packages/cli/src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "packages",
    "schemas",
    "python",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -b && tsx packages/core/src/emit-schemas.ts",
    "emit-schemas": "tsx packages/core/src/emit-schemas.ts",
    "sysprompt": "tsx packages/cli/src/cli.ts",
    "spl": "tsx packages/cli/src/cli.ts",
    "suite-viewer": "tsx packages/suite-viewer/src/cli.ts",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s python/tests -t python",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahzark/Sysprompt-Lab.git"
  },
  "keywords": [
    "system-prompt",
    "eval",
    "cli"
  ],
  "dependencies": {
    "@sysprompt-lab/cli": "*",
    "@sysprompt-lab/core": "*",
    "@sysprompt-lab/eval": "*",
    "@sysprompt-lab/llm": "*",
    "@sysprompt-lab/rewrite": "*",
    "@sysprompt-lab/rungs": "*",
    "@sysprompt-lab/suite-viewer": "*",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.13.10",
    "ajv": "^8.17.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "zod-to-json-schema": "^3.24.5"
  }
}
