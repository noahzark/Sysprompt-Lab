    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sysprompt": "tsx src/cli.ts",
    "spl": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@sysprompt-lab/core": "*",
    "@sysprompt-lab/llm": "*",
    "@sysprompt-lab/rewrite": "*",
    "@sysprompt-lab/rungs": "*",
    "commander": "^13.1.0"
