{
  "name": "@sysprompt-lab/cli",
  "version": "0.1.0",
  "description": "sysprompt / spl CLI and ingest/bind/export/promote commands.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sysprompt": "./src/cli.ts",
    "spl": "./src/cli.ts"
  },
  "exports": {
